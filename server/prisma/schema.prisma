// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  // Nullable only during the non-destructive Lab 2 data migration. A later
  // migration makes this required after every legacy user has been backfilled.
  passwordHash       String?
  role               UserRole @default(REQUESTER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets             Ticket[]     @relation("TicketRequester")
  ownedTickets        Ticket[]     @relation("TicketOwner")
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  removedAttachments  Attachment[] @relation("AttachmentRemover")
  publicComments      PublicComment[]
  internalNotes       InternalNote[]
  sessions            Session[]
  createdActions      ActionTaken[]      @relation("ActionCreator")
  assignedActions     ActionTaken[]      @relation("ActionAssignee")
  performedActions    ActionTaken[]      @relation("ActionPerformer")
  actionEvents        ActionTakenEvent[] @relation("ActionEventActor")

  @@index([role, isActive])
}

// ─── Server-side Session ────────────────────────────────────────────────────

model Session {
  id            String    @id
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ─── Related System ───────────────────────────────────────────────────────────

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique

  requesterId Int
  requester   User @relation("TicketRequester", fields: [requesterId], references: [id])

  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  summary     String
  description String

  requestedPriority Priority     @default(MEDIUM)
  itPriority        Priority     @default(MEDIUM)
  currentStatus     TicketStatus @default(NEW)
  requesterResolvedAt DateTime?
  resolvedAt DateTime?
  version Int @default(1)

  ticketOwnerId Int?
  ticketOwner   User? @relation("TicketOwner", fields: [ticketOwnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actionsTaken ActionTaken[]

  @@index([requesterId])
  @@index([currentStatus, categoryId, requestedPriority])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([ticketOwnerId])
  @@index([currentStatus, updatedAt])
  @@index([requesterId, updatedAt])
  @@index([currentStatus, resolvedAt])
  @@index([ticketOwnerId, currentStatus, updatedAt])
}

model ActionTaken {
  id Int @id @default(autoincrement())
  ticketId Int
  ticket Ticket @relation(fields: [ticketId], references: [id])
  clientRequestId String @db.Uuid
  actionAt DateTime @db.Timestamptz(3)
  description String
  result String?
  status ActionStatus @default(PLANNED)
  assigneeId Int?
  assignee User? @relation("ActionAssignee", fields: [assigneeId], references: [id])
  createdById Int
  createdBy User @relation("ActionCreator", fields: [createdById], references: [id])
  performedById Int?
  performedBy User? @relation("ActionPerformer", fields: [performedById], references: [id])
  completedAt DateTime? @db.Timestamptz(3)
  followUpRequired Boolean @default(false)
  followUpNote String?
  attachmentNotes String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events ActionTakenEvent[]

  @@unique([createdById, ticketId, clientRequestId])
  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status, updatedAt])
  @@index([performedById, completedAt])
}

model ActionTakenEvent {
  id Int @id @default(autoincrement())
  actionTakenId Int
  actionTaken ActionTaken @relation(fields: [actionTakenId], references: [id])
  actorId Int
  actor User @relation("ActionEventActor", fields: [actorId], references: [id])
  eventType ActionEventType
  prior Json?
  next Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([actionTakenId, createdAt, id])
}

// ─── Attachment ───────────────────────────────────────────────────────────────

model Attachment {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  uploaderId Int
  uploader   User @relation("AttachmentUploader", fields: [uploaderId], references: [id])

  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  storagePath      String

  removedAt            DateTime?
  removedByRequesterId Int?
  removedBy            User? @relation("AttachmentRemover", fields: [removedByRequesterId], references: [id])
  removalReason        String?

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── Lab 3 Ticket collaboration ────────────────────────────────────────────

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}
